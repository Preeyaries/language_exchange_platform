# Copy to backend/.env and fill in your own values. Never commit backend/.env.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/bello

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

PORT=5000

# Optional. Comma-separated list of origins allowed to call the API.
# Leave empty for local development. Not needed when Nginx serves the
# frontend and the API from the same address.
CLIENT_URL=
